@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <MudMenu id="signedInMenu" AnchorOrigin="Origin.CenterCenter">
            <ActivatorContent>
                <MudAvatar>@context.User.Identity?.Name?.ToUpper().First()</MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <div class="py-2" style="min-width: 220px">
                    <MudMenuItem id="profileMenuItem" Href="./account/profile" IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.PeopleAlt">Profile</MudMenuItem>
                    
                    <MudMenuItem OnClick="Profile">
                        <div class="d-flex">
                            <MudIcon Class="mx-2" Icon="@Icons.Material.Filled.Person" />
                            <MudText>Account</MudText>
                        </div>
                    </MudMenuItem>
                    
                    <div class="mt-4 mx-4">
                        <MudButton Color="Color.Error" FullWidth="true" StartIcon="@Icons.Material.Filled.Logout" DropShadow="false"
                                   Variant="Variant.Filled" OnClick="Logout">
                            Logout
                        </MudButton>
                    </div>
                    <div class="mt-4 mx-4">
                        <form action="/account/logout" method="post">
                            <AntiforgeryToken/>
                            <MudTextField InputType="InputType.Hidden" @bind-Value="_currentUrl" For="@(() => _currentUrl)"/>
                            <MudButton
                                ButtonType="ButtonType.Submit"
                                Color="Color.Inherit"
                                FullWidth="true"
                                StartIcon="@Icons.Material.Filled.Logout"
                                IconColor="Color.Tertiary"
                                DropShadow="false"
                                Variant="Variant.Filled">
                                Sign out
                            </MudButton>
                        </form>
                    </div>
                </div>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudToolBar Spacing="5">
            <MudButton id="loginPageLink" Href="account/login"
                       Variant="Variant.Text"
                       Color="Color.Tertiary" Class="mr-5"
                       StartIcon="@Icons.Material.Filled.Login">Login
            </MudButton>
            @* <PersonCard Class="mr-5"/> *@
        </MudToolBar>
    </NotAuthorized>
</AuthorizeView>

@code{
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Navigation.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
    
    private void Profile()
    {
        Navigation.NavigateTo("/identity/account");
    }
    
    private void Logout()
    {
        var parameters = new DialogParameters
        {
            { nameof(Components.Dialogs.Logout.ContentText), "Do you want to logout from the system?"},
            { nameof(Components.Dialogs.Logout.ButtonText), "Logout"},
            { nameof(Components.Dialogs.Logout.Color), Color.Error}
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        DialogService.Show<Logout>("Logout", parameters, options);
    }
    
}