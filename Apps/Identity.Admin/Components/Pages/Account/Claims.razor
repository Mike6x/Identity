@page "/identity/claims"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<PageTitle>User Claims</PageTitle>

<h1>@UserName Claims</h1>
<br/>
<br/>
@if (_claims.Any())
{
    <ul>
        @foreach (var claim in _claims)
        {
            <li><b>@claim.Type:</b> @claim.Value</li>
        }
    </ul>
}
<br/>
<br/>
<AuthorizeView>
    <Authorized>
        <h2>Hello @context.User.Identity?.Name</h2>
        <br/>
        <h4>Here's the list of your claims:</h4>
        <ul>
            @foreach (var claimGroup in context.User.Claims.GroupBy(a => a.Type))
            {
                foreach (var claimValue in claimGroup.Select(s => s.Value).Distinct())
                {
                    <li><b>@claimGroup.Key</b>: @claimValue</li>
                }
            }
        </ul>
        <br/>
        <div class="alert alert-warning" role="alert">
            Before authentication will function correctly, you must configure your provider details in <code>Program.cs</code>
        </div>
    </Authorized>

</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <p>Your authorization roles:</p>
        <ul>
            @foreach (Claim role in context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
            {
                <li>@role.Value</li>
            }
        </ul>
        <p>Your authorization permissions:</p>
        <ul>
            @foreach (Claim permission in context.User.Claims.Where(c => c.Type == "permissions"))
            {
                <li>@permission.Value</li>
            }
        </ul>
    </Authorized>
</AuthorizeView>

@code {
    private IEnumerable<Claim> _claims = [];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? UserName { get; set; }
    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null) return;

        var authState = await AuthState;
        _claims = authState.User.Claims;
        UserName = authState.User.Identity == null ? "Unknown" : authState.User.Identity?.Name;
    }
}
