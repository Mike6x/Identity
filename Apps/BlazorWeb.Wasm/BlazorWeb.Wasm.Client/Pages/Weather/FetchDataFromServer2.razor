@page "/Weather/WeatherForecastFromServer2"
@rendermode InteractiveServer
@attribute [StreamRendering]

@using Identity.Shared.Resource_Server_2

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Weather forecast - Resource Server 2</PageTitle>

<h1>Weather Forecast - Resource Server 2</h1>

<p>This component demonstrates fetching data from remote server 2.</p>

@if (_forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <button class="btn btn-primary" @onclick="ClearForecast">Clear</button>
    <button class="btn btn-primary" @onclick="PublicForecast">Public Forecast</button>
    <button class="btn btn-primary" @onclick="SecureForecast">Secure Forecast</button>
    <button class="btn btn-primary" @onclick="PaidForecast">Paid Forecast</button>
    
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>Temp. (C)</th>
            <th>Temp. (F)</th>
            <th>Summary</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var forecast in _forecasts)
        {
            <tr>
                <td>@forecast.Date.ToShortDateString()</td>
                <td>@forecast.TemperatureC</td>
                <td>@forecast.TemperatureF</td>
                <td>@forecast.Summary</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private WeatherForecast[]? _forecasts;
    
        
    private void ClearForecast()
    {
        _forecasts = [];
    }
    
    private async Task PublicForecast()
    {
        _forecasts = null;
        await Task.Delay(500);
        try
        {
            var httpClient = HttpClientFactory.CreateClient("resource2Client");
            _forecasts = await httpClient.GetFromJsonAsync<WeatherForecast[]>("api/WeatherForecast/public-forecast") ?? [];
        }
        catch (Exception ex)
        {
            _forecasts = [];
            Console.WriteLine("The Error is :" + ex.ToString());
        }

    }
    
    private async Task SecureForecast()
    {
        _forecasts = null;
        await Task.Delay(500);
        try
        {
            var httpClient = HttpClientFactory.CreateClient("resource2Client");
            _forecasts = await httpClient.GetFromJsonAsync<WeatherForecast[]>("api/WeatherForecast/secure-forecast") ?? [];
        }
        catch (Exception ex)
        {
            _forecasts = [];
            Console.WriteLine("The Error is :" + ex.ToString());
        }
    }
    
    private async Task PaidForecast()
    {
        _forecasts = null;
        await Task.Delay(500);
        try
        {
            var httpClient = HttpClientFactory.CreateClient("resource2Client");
            _forecasts = await httpClient.GetFromJsonAsync<WeatherForecast[]>("api/WeatherForecast/paid-forecast") ?? [];
        }
        catch (Exception ex)
        {
            _forecasts = [];
            Console.WriteLine("The Error is :" + ex.ToString());
        }

    }

    
    protected override async Task OnInitializedAsync()
    {
        var startDate = DateTime.Now;
        
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
        _forecasts = Enumerable.Range(1, 5).Select(index => new WeatherForecast
        {
            Id = 0,
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(index)),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();
    }
}
