@page "/City"
@using Identity.Shared.Resource_Server_3.Dtos

@inject IHttpClientFactory HttpClientFactory

<h3>City</h3>

@if (_itemlist == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>State</th>
            <th>Population</th>
            <th>Elevation</th>
            <th>CurrentTimeLocal</th>
            <th>Temp. (C)</th>
            <th>Temp. (F)</th>

        </tr>
        </thead>
        <tbody>
        @foreach (var item in _itemlist)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.State</td>
                <td>@item.Population</td>
                <td>@item.Elevation</td>
                <td>@item.CurrentTimeLocal</td>

                <td>@item.Temperatures.SummerHighFahrenheit</td>
                <td>@item.Temperatures.WinterLowFahrenheit</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private CityInfoDto[]? _itemlist;
    

    protected override async Task OnInitializedAsync()
    {
        var http = HttpClientFactory.CreateClient("resource3Client");
        _itemlist = await http.GetFromJsonAsync<CityInfoDto[]>("api/cities")
                                ?? throw new IOException("Server Not Found!");
    }
}