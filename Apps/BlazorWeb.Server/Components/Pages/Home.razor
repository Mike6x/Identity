@page "/"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<h1>Weather Forecast - Blazor Web Server</h1>
<br/>
Welcome to Oidc Sample App with OpenIddict Auth Server.
<br/>
<br/>
<AuthorizeView>
    <Authorized>
        <h4>Short description of auth demo app idea:</h4>
        <br/>
        <p><a href="">Home</a> page uses basic authorization without roles/permissions</p>
        <p><a href="profile">Current User profile</a> page uses roles as authorization (RBAC)</p>

        <p><a href="Cities">CRUD UI for City From Server 3</a> Fetch data from remote api service https://localhost:7203/</p>
 
        <p><a href="WeatherForecastFromServer2">Weather Forecast From Server 2</a> Fetch data from remove api service https://localhost:7202/ )</p>
        <p><a href="WeatherForecastFromServer3">Weather Forecast From Server 3</a> Fetch data from remote api service https://localhost:7203/</p>

        <br/>
        <h4>Hello, @context.User.Identity!.Name</h4>
        <p>Your authorization roles:</p>
        <ul>
            @foreach (Claim role in context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
            {
                <li>@role.Value</li>
            }
        </ul>
        
        <p>Your authorization permissions:</p>
        <ul>
            @foreach (Claim permission in context.User.Claims.Where(c => c.Type == "permissions"))
            {
                <li>@permission.Value</li>
            }
        </ul>
    </Authorized>
</AuthorizeView>
