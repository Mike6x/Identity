@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.


<AuthorizeView>
    <Authorized>
        <h1>Hello, world!</h1>
        <br/>
        <h2>Hello @context.User.Identity?.Name, here's the list of your claims:</h2>
        <ul>
            @foreach (var claimGroup in context.User.Claims.GroupBy(a => a.Type))
            {
                foreach (var claimValue in claimGroup.Select(s => s.Value).Distinct())
                {
                    <li><b>@claimGroup.Key</b>: @claimValue</li>
                }
            }
        </ul>
        <br/>
        <div class="alert alert-warning" role="alert">
            Before authentication will function correctly, you must configure your provider details in <code>Program.cs</code>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin/>
    </NotAuthorized>
</AuthorizeView>