@page "/Student/EditStudent/{id:int}"
@rendermode InteractiveServer

@using Identity.Shared.Resource_Server_3.Dtos

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<h3>Edit Student</h3>
<div class="container">
    <div class="row">
        <div class="col-8">
            <EditForm Model="_item" method="post"  OnValidSubmit="UpdateStudentMethod" FormName="UpdateStudent">
                <div class="form-group">
                    <label class="form-label">Id</label>
                    @if (_item != null)
                    {
                        <InputNumber class="form-control" @bind-Value=_item.Id></InputNumber>
                        @:</div>
                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value=_item.FirstName></InputText>
                        </div>
                        <div class="form-group">
                            <label class="form-label">LastName</label>
                            <InputText class="form-control" @bind-Value=_item.LastName></InputText>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Sex</label>
                            <InputText class="form-control" @bind-Value=_item.Sex></InputText>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Age</label>
                            <InputNumber class="form-control" @bind-Value=_item.Age></InputNumber>
                        </div>

                        @:<div class="form-group">
                        <label class="form-label">Major</label>
                        <InputText class="form-control" @bind-Value=_item.Major></InputText>
                    }


                </div>


                <button class="btn btn-primary mt-3" type="submit">Update</button>
                
            </EditForm>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public int Id { get; set; }

    StudentDto? _item = new ();

    protected override async Task OnInitializedAsync()
    {
        
        var http = HttpClientFactory.CreateClient("resource3Client");
            
        _item = await http.GetFromJsonAsync<StudentDto>($"api/students/{Id}");
    }

    private void UpdateStudentMethod()
    {
        var http = HttpClientFactory.CreateClient("resource3Client");

        if (_item != null) http.PutAsJsonAsync($"api/Students/{_item.Id}", _item);

        Navigation.NavigateTo("Student/Students",true);
    }
}