<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link">
                    Logout
                </button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Account/Login" data-enhance-nav="false">
                <span class="bi bi-person-badge" aria-hidden="false"></span> Login
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>