<AuthorizeView>
    <Authorized>
        <strong>Hello, @context?.User?.Identity?.Name!</strong>
        <form method="post" action="api/Account/Logout">
            <AntiForgeryTokenInput/>
            <button class="btn btn-link" type="submit">Sign out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a href="api/Account/Login">Log in</a>
    </NotAuthorized>
</AuthorizeView>